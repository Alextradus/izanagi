# Valeurs par défaut de la pile Rust ; elles remplacent celles du cœur.
verification=scripts/check.sh
test_manuel=cargo install --path . --locked
fichier_version=`version` du `Cargo.toml` racine (`[workspace.package]` dans un workspace), avec `Cargo.lock` commité
hors_revue=`Cargo.lock`, `docs/superpowers/plans/`, `.superpowers/`
