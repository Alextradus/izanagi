# Valeurs par défaut du cœur, une par ligne : clé=valeur.
# Le gabarit de la pile, puis le fichier de valeurs passé à install.sh, les remplacent.
decisions=la section « Décisions » de la spec
plans=docs/plans/
branche=main
verification=scripts/check.sh
taille_tranche=1 500
vault=non
hors_revue=`docs/plans/`, `.izanagi/`
systemes=linux,windows
type=à préciser
# Composant qui porte la version du projet, lue par release.yml. Vide : le premier composant.
version_composant=
hook_push=bloque
hook_verification=bloque
hook_destructif=demande
navigateur=non
mutation_delai=15
